{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GooglePlaces": {
    "ApiKey": "",
    "LimiteDiario": 100
  },
  "Embeddings": {
    "BaseUrl": "http://localhost:8084/",
    "Model": "BAAI/bge-m3",
    "TextBuilderVersion": "v1",
    "Backfill": {
      "Enabled": true,
      "IntervalSeconds": 300,
      "BatchSize": 32,
      "MaxBackoffSeconds": 3600,
      "SampleSize": 20,
      "SimilarityThreshold": 0.999
    }
  }
}
